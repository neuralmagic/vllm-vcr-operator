#!/bin/sh
# vcr-profile-export-volume runs the real profile exporter with a staging parent
# inside the writable profile volume.
#
# Why this shim exists (and what it is not):
#
# cmd/profileexport stages its output in a temporary directory next to the target
# directory and renames it into place. The operator runs the provisioner with the
# profile emptyDir mounted at /var/run/vcr/profile and everything else read-only
# (internal/runtime/runtime.go, provisionerContainer: ReadOnlyRootFilesystem true),
# so the exporter's staging parent /var/run/vcr is not writable and the export
# fails with EROFS. Verified on a real kind cluster (see test/cluster/README.md,
# "Known product defect").
#
# This shim keeps the real exporter — including the metadata/trace validation that
# is the whole point of running it — and only moves its staging directory into the
# mounted volume. It exists in the *test* profile image so the acceptance suite can
# demonstrate provisioning and every stage after it. It is not a product fix: the
# fix belongs in internal/runtime (make the provisioner's staging parent writable,
# for example by mounting the profile volume's parent or by giving the exporter a
# staging directory inside the target).
#
# Usage (the operator appends the target directory):
#   vcr-profile-export-volume <target-dir>
set -eu

target="${1:?usage: vcr-profile-export-volume <target-dir>}"
mkdir -p "$target"

# The exporter removes and renames its target, so it must not write to the mount
# point itself. Export into a staging directory inside the mounted volume, then
# move the verified files into place.
staging="$target/.vcr-export"

/usr/local/bin/vcr-profile-export --source /profile "$staging"

for name in metadata.json trace.jsonl.gz; do
  if [ ! -s "$staging/$name" ]; then
    echo "vcr-profile-export-volume: the exporter produced no $name in $staging" >&2
    exit 1
  fi
done

rm -f "$target/metadata.json" "$target/trace.jsonl.gz"
mv "$staging/metadata.json" "$staging/trace.jsonl.gz" "$target/"
rmdir "$staging"
