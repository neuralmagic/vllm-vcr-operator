# vllm-vcr pin record -- the simulator release this operator build translates.
#
# Read by hack/check-vllm-vcr-upstream.sh, which fails when the upstream project
# moves away from this record, when the translator emits a `play` flag the release
# does not define, or when the simulator's default vLLM line stops matching the
# release the operator translates (internal/names/names.go).
#
# The narrative record -- what was inspected, what was adapted, and how to re-pin a
# future release -- is docs/upstream-vllm-vcr.md. Update both files together.

# Commit and release tag of the pinned simulator build.
VLLM_VCR_PIN_COMMIT=22e64afcd7021da06a9ee3616574a2c03d380180
VLLM_VCR_PIN_TAG=v0.2.5
VLLM_VCR_PIN_TAG_DATE=2026-11-06
VLLM_VCR_PIN_VERIFIED=2026-11-18

# The vLLM support window of the pinned build: compat.toml's default line and its tag.
VLLM_VCR_PIN_DEFAULT_LINE=0.33
VLLM_VCR_PIN_DEFAULT_TAG=v0.33.0

# The vLLM release this operator translates. Must equal
# names.SupportedVLLMVersion, and its major.minor must equal the default line above.
VLLM_VCR_TARGET_VERSION=0.33.0
